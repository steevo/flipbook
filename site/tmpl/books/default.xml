<?xml version="1.0" encoding="UTF-8"?>
<metadata>
	<layout title="COM_FLIPBOOK_BOOKS_VIEW_DEFAULT_TITLE">
		<message>COM_FLIPBOOK_BOOKS_VIEW_DEFAULT_DESC</message>
	</layout>

	<!-- Livres affichés et ordre de l'étagère -->
	<fields name="params">
		<fieldset name="basic" label="COM_FLIPBOOK_SHELF_OPTIONS">
			<field
				name="catid"
				type="category"
				label="JCATEGORY"
				description="COM_FLIPBOOK_SHELF_CATEGORY_DESC"
				extension="com_flipbook"
				published="1"
				default="0"
			>
				<option value="0">COM_FLIPBOOK_SHELF_ALL_CATEGORIES</option>
			</field>
			<field
				name="show_subcategory_content"
				type="radio"
				label="COM_FLIPBOOK_SHELF_SUBCATEGORIES"
				layout="joomla.form.field.radio.switcher"
				default="1"
				showon="catid!:0"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="orderby"
				type="list"
				label="COM_FLIPBOOK_SHELF_ORDER"
				default="rordering"
				validate="options"
			>
				<option value="rordering">COM_FLIPBOOK_ORDER_RORDERING</option>
				<option value="ordering">COM_FLIPBOOK_ORDER_ORDERING</option>
				<option value="rdate">COM_FLIPBOOK_ORDER_RDATE</option>
				<option value="date">COM_FLIPBOOK_ORDER_DATE</option>
				<option value="alpha">COM_FLIPBOOK_ORDER_ALPHA</option>
				<option value="ralpha">COM_FLIPBOOK_ORDER_RALPHA</option>
				<option value="hits">COM_FLIPBOOK_ORDER_HITS</option>
			</field>
		</fieldset>
	</fields>
</metadata>
