<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_flipbook</name>
	<creationDate>2026-11</creationDate>
	<author>Philippe Ousset</author>
	<authorEmail>steevo@steevo.fr</authorEmail>
	<authorUrl>www.steevo.fr</authorUrl>
	<copyright>Copyright (C) 2026 Philippe Ousset. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.6.1</version>
	<description>COM_FLIPBOOK_XML_DESCRIPTION</description>
	<namespace path="src">Steevo\Component\Flipbook</namespace>
	<scriptfile>script.php</scriptfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>language</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<media destination="com_flipbook" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<administration>
		<menu img="class:book">COM_FLIPBOOK</menu>
		<submenu>
			<menu link="option=com_flipbook&amp;view=books">COM_FLIPBOOK_BOOKS</menu>
			<menu link="option=com_categories&amp;extension=com_flipbook">COM_FLIPBOOK_CATEGORIES</menu>
		</submenu>
		<files folder="admin">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>
</extension>
