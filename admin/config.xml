<?xml version="1.0" encoding="UTF-8"?>
<config>
	<fieldset name="reader" label="COM_FLIPBOOK_CONFIG_READER">
		<field
			name="storage_path"
			type="text"
			default="flipbook"
			label="COM_FLIPBOOK_CONFIG_STORAGE_PATH"
			description="COM_FLIPBOOK_CONFIG_STORAGE_PATH_DESC"
		/>
		<field
			name="free_pages"
			type="number"
			default="1"
			min="0"
			label="COM_FLIPBOOK_CONFIG_FREE_PAGES"
			description="COM_FLIPBOOK_CONFIG_FREE_PAGES_DESC"
		/>
		<field
			name="flipping_time"
			type="number"
			default="700"
			min="100"
			max="3000"
			step="100"
			label="COM_FLIPBOOK_CONFIG_FLIPPING_TIME"
			description="COM_FLIPBOOK_CONFIG_FLIPPING_TIME_DESC"
		/>
		<field
			name="preload"
			type="number"
			default="3"
			min="1"
			max="10"
			label="COM_FLIPBOOK_CONFIG_PRELOAD"
			description="COM_FLIPBOOK_CONFIG_PRELOAD_DESC"
		/>
		<field
			name="show_title"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			default="1"
			label="COM_FLIPBOOK_CONFIG_SHOW_TITLE">
			<option value="0">JHIDE</option>
			<option value="1">JSHOW</option>
		</field>
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			filter="rules"
			validate="rules"
			component="com_flipbook"
			section="component"
		/>
	</fieldset>
</config>
